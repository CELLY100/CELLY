# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe Secret Key (e.g. sk_live_... or sk_test_...) for processing real credit card payments.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional Stripe Webhook signing secret (whsec_...) for verifying incoming checkout webhooks.
STRIPE_WEBHOOK_SECRET=""

# ADMIN_NOTIFICATION_EMAIL: Target email address where mastering orders, contact forms, and order notifications are sent immediately.
ADMIN_NOTIFICATION_EMAIL="wspcelly@gmail.com"

# EMAIL CONFIGURATION (Live Transactional Email Delivery):
# Recommended: RESEND_API_KEY (Uses direct HTTPS port 443 — works seamlessly in cloud containers)
RESEND_API_KEY=""

# Alternative 1: Gmail SMTP (Use your Gmail address + a 16-character Google App Password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Alternative 2: SendGrid API Key (Uses HTTPS port 443)
SENDGRID_API_KEY=""

# Alternative 3: Standard Custom SMTP server
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Sender Display and Support Email
EMAIL_FROM="CELLY <orders@celly.com>"
